# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:clave@localhost:5432/oziris_db?schema=public"

# Secreto para firmar los JWT (OBLIGATORIO, mínimo 32 caracteres aleatorios)
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto del API
PORT=4000

# Origen(es) del frontend permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:3000

# Correo para recuperación de contraseña (Gmail + contraseña de aplicación de 16 caracteres)
MAIL_USER=
MAIL_PASS=
